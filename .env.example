POSTWISE_APP_ENV=dev
POSTWISE_LOG_LEVEL=INFO

# Primary: Groq
POSTWISE_LLM_PROVIDER=groq
POSTWISE_LLM_MODEL=llama-3.3-70b-versatile
POSTWISE_LLM_API_KEY=

# Fallback: Together AI (used by pipeline.py in Phase 5 if primary fails)
POSTWISE_LLM_FALLBACK_PROVIDER=together
POSTWISE_LLM_FALLBACK_MODEL=Qwen/Qwen3.5-9B
POSTWISE_LLM_FALLBACK_API_KEY=

POSTWISE_LLM_TIMEOUT_S=30
POSTWISE_LLM_MAX_RETRIES=2